OPENQASM 3;

cal {
	waveform wfm_flux = load_numpy_encoded();
}


include 'stdgates_transmon_fixed_coupler.inc';

bit[2] c;
qubit[2] q;

defcal cz $0, $1
{
play(flux($1), wfm_flux);
}

z q[0];
rx(pi/2) q[0];

z q[1];
ry(pi/2) q[1];

cz q[0], q[1];

z q[1];
ry(pi/2) q[1];

delay[0]  q[0], q[1];
c[0] = measure q[0];
c[1] = measure q[1];
